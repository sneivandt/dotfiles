root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.qml]
indent_size = 4

[*.toml]
indent_size = 2

[*.{ps1,psm1,psd1,psxml}]
indent_style = space
indent_size = 4

[symlinks/config/hypr/**/*.lua]
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[*.json]
indent_size = 2

[{.vscode/*.json,symlinks/config/Code/User/*.json,symlinks/AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json}]
indent_size = 4

[*.ini]
indent_size = 2

[*.{vim,vimrc}]
indent_size = 2

[{.gitignore,.gitattributes}]
indent_size = 2
