{
  "name": "dotfiles-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vitepress dev --port 3000 --strictPort",
    "check": "vue-tsc --noEmit",
    "build": "vitepress build",
    "preview": "vitepress preview --port 3000",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "mermaid": "12.3.0",
    "vitepress": "1.6.4",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "6.4.5",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "vite": "$vite",
    "esbuild": "$esbuild"
  }
}
