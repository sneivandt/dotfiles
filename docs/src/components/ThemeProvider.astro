---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
---

<script is:inline>
  // An empty value is Starlight's saved System choice, not a missing preference.
  if (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme') === null) {
    localStorage.setItem('starlight-theme', 'dark');
  }
</script>
<ThemeProvider />
