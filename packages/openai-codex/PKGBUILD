# shellcheck shell=bash
# shellcheck disable=SC2034
# Maintained here; dotfiles update generates ignored version.sh release pins.
pkgname=openai-codex-dotfiles
pkgrel=1
pkgdesc='OpenAI coding agent for the terminal (official binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/openai/codex'
license=('Apache-2.0')
depends=('glibc' 'alsa-lib')
optdepends=(
  'git: repository operations'
  'ripgrep: accelerated repository search'
  'pipewire-alsa: voice audio through PipeWire'
)
conflicts=('openai-codex' 'openai-codex-bin' 'openai-codex-autoup-bin')
options=('!strip' '!debug')
source=('LICENSE' 'NOTICE')
sha256sums=('d17f227e4df5da1600391338865ce0f3055211760a36688f816941d58232d8dc' '9d71575ecfd9a843fc1677b0efb08053c6ba9fd686a0de1a6f5382fd3c220915')
source ./version.sh
provides=("openai-codex=${pkgver}" "openai-codex-bin=${pkgver}")
source_x86_64=("codex-package-${pkgver}-x86_64.tar.gz::${url}/releases/download/rust-v${pkgver}/codex-package-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("codex-package-${pkgver}-aarch64.tar.gz::${url}/releases/download/rust-v${pkgver}/codex-package-aarch64-unknown-linux-musl.tar.gz")

package() {
  install -dm755 "${pkgdir}/opt/openai-codex" "${pkgdir}/usr/bin"
  local item
  for item in bin codex-package.json codex-path codex-resources; do
    cp -a --no-preserve=ownership "${srcdir}/${item}" "${pkgdir}/opt/openai-codex/"
  done
  ln -s /opt/openai-codex/bin/codex "${pkgdir}/usr/bin/codex"
  ln -s /opt/openai-codex/bin/codex-code-mode-host "${pkgdir}/usr/bin/codex-code-mode-host"
  local shell
  for shell in bash zsh fish elvish powershell; do
    "${srcdir}/bin/codex" completion "$shell" > "${srcdir}/codex.${shell}"
  done
  install -Dm644 "${srcdir}/codex.bash" "${pkgdir}/usr/share/bash-completion/completions/codex"
  install -Dm644 "${srcdir}/codex.zsh" "${pkgdir}/usr/share/zsh/site-functions/_codex"
  install -Dm644 "${srcdir}/codex.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/codex.fish"
  install -Dm644 "${srcdir}/codex.elvish" "${pkgdir}/usr/share/elvish/lib/codex.elv"
  install -Dm644 "${srcdir}/codex.powershell" "${pkgdir}/usr/share/powershell/Completions/codex.ps1"
  install -Dm644 "${startdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${startdir}/NOTICE" "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
}
