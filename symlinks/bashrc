#!/usr/bin/env bash
# Dotfiles Bash interactive startup
# shellcheck shell=bash
# shellcheck source-path=SCRIPTDIR

# Only run for interactive shells
[[ $- != *i* ]] && return

# Guard against multiple sourcing
[ -n "${BASHRC_LOADED:-}" ] && return
BASHRC_LOADED=1

# A new terminal or tmux pane must not retain the parent shell's GPG tty.
if tty -s; then
  GPG_TTY="$(tty)"
  export GPG_TTY
fi

# Shared interactive helpers
# shellcheck source=config/shell/interactive.sh
[ -r ~/.config/shell/interactive.sh ] && . ~/.config/shell/interactive.sh

# History
if command -v _dotfiles_init_history >/dev/null 2>&1; then
  _dotfiles_init_history bash Bash
else
  HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
fi
export HISTFILE
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth
shopt -s histappend
shopt -s checkwinsize
shopt -s globstar

# Save each completed command without replacing history from other shells.
__bash_history_append() { history -a; }
PROMPT_COMMAND=("${PROMPT_COMMAND[@]}" __bash_history_append)

# Path
# shellcheck source=config/shell/path.sh
[ -r ~/.config/shell/path.sh ] && . ~/.config/shell/path.sh

# virtualenvwrapper
if command -v _dotfiles_init_virtualenvwrapper >/dev/null 2>&1; then
  _dotfiles_init_virtualenvwrapper
fi

# Aliases
# shellcheck source=config/shell/aliases.sh
[ -r ~/.config/shell/aliases.sh ] && . ~/.config/shell/aliases.sh

# GUI Aliases (optional)
# shellcheck source=config/shell/aliases-desktop.sh
[ -r ~/.config/shell/aliases-desktop.sh ] && . ~/.config/shell/aliases-desktop.sh

# Prompt
# shellcheck source=config/bash/prompt.bash
[ -r ~/.config/bash/prompt.bash ] && . ~/.config/bash/prompt.bash

# zoxide
if command -v zoxide >/dev/null 2>&1
then
  eval "$(zoxide init bash)"
fi

# FZF (optional)
if command -v _dotfiles_init_fzf >/dev/null 2>&1; then
  _dotfiles_init_fzf bash
fi

unset -f _dotfiles_init_history _dotfiles_init_virtualenvwrapper _dotfiles_init_fzf 2>/dev/null || true
