#!/usr/bin/env bash
# shellcheck shell=bash

# Only run for interactive shells
[[ $- != *i* ]] && return

# Guard against multiple sourcing
[ -n "$BASHRC_LOADED" ] && return
BASHRC_LOADED=1

# A new terminal or tmux pane must not retain the parent shell's GPG tty.
if tty -s; then
  GPG_TTY="$(tty)"
  export GPG_TTY
fi

# History
_bash_legacy_history="${XDG_CACHE_HOME:-$HOME/.cache}/bash/history"
export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
if mkdir -p "$(dirname -- "$HISTFILE")"; then
  # Keep the old file for shells still using it; never replace newer state.
  if [[ ! -e $HISTFILE && -f $_bash_legacy_history ]]; then
    if ! (umask 077; cp -n -- "$_bash_legacy_history" "$HISTFILE"); then
      printf 'Could not migrate Bash history; keeping the previous location.\n' >&2
      HISTFILE="$_bash_legacy_history"
    fi
  fi
else
  HISTFILE="$_bash_legacy_history"
fi
unset _bash_legacy_history
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth
shopt -s histappend
shopt -s checkwinsize
shopt -s globstar

# Save each completed command without replacing history from other shells.
__bash_history_append() { history -a; }
PROMPT_COMMAND=("${PROMPT_COMMAND[@]}" __bash_history_append)

# Path
# shellcheck disable=SC1090
[ -r ~/.config/shell/path.sh ] && . ~/.config/shell/path.sh

# Aliases
# shellcheck disable=SC1090
[ -r ~/.config/shell/aliases.sh ] && . ~/.config/shell/aliases.sh

# GUI Aliases (optional)
# shellcheck disable=SC1090
[ -r ~/.config/shell/aliases-desktop.sh ] && . ~/.config/shell/aliases-desktop.sh

# Prompt
# shellcheck disable=SC1090
[ -r ~/.config/bash/prompt.bash ] && . ~/.config/bash/prompt.bash

# zoxide
if command -v zoxide >/dev/null 2>&1
then
  eval "$(zoxide init bash)"
fi

# FZF (optional)
# Prefer packaged scripts, including older Debian/Ubuntu FZF versions without
# --bash. Keep this aligned with the equivalent block in zshrc.
for _fzf_dir in /usr/share/fzf /usr/share/doc/fzf/examples; do
  if [ -f "$_fzf_dir/key-bindings.bash" ] || [ -f "$_fzf_dir/completion.bash" ]; then
    # shellcheck disable=SC1090
    [ ! -f "$_fzf_dir/key-bindings.bash" ] || . "$_fzf_dir/key-bindings.bash"
    # shellcheck disable=SC1090
    [ ! -f "$_fzf_dir/completion.bash" ] || . "$_fzf_dir/completion.bash"
    break
  fi
done
if [ ! -f "$_fzf_dir/key-bindings.bash" ] && [ ! -f "$_fzf_dir/completion.bash" ] && command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi
unset _fzf_dir
