[pretty]
  compact = %Cred%h%Creset%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset

[alias]

  # Add
  ad  = add
  aa  = add --all

  # Branch
  br  = branch
  brd = branch -d
  brl = branch --list --format '%(HEAD) %(color:red)%(objectname:short)%(color:reset) - %(color:yellow)%(refname:short)%(color:reset) %(contents:subject) %(color:green)(%(committerdate:relative))%(color:reset) %(color:blue)<%(authorname)>%(color:reset)'

  # checkout
  ch  = checkout
  cb  = checkout -b

  # commit
  ci  = commit -m
  cia = commit --amend --reuse-message=HEAD

  # clean
  cal = clean -xdi

  # clone
  cl  = clone
  clr = clone --recursive

  # cherry-pick
  cp  = cherry-pick

  # diff
  di  = diff
  dis = diff --staged

  # difftool
  dt  = difftool
  dts = difftool --staged

  # fetch
  fe  = fetch

  # grep
  gr  = grep --color=auto --ignore-case -n

  # log
  lo  = log --graph --pretty=compact --abbrev-commit
  lo1 = log --graph --pretty=compact --abbrev-commit -n 1
  lo2 = log --graph --pretty=compact --abbrev-commit -n 2
  lo3 = log --graph --pretty=compact --abbrev-commit -n 3
  lo4 = log --graph --pretty=compact --abbrev-commit -n 4
  lo5 = log --graph --pretty=compact --abbrev-commit -n 5
  lo6 = log --graph --pretty=compact --abbrev-commit -n 6
  lo7 = log --graph --pretty=compact --abbrev-commit -n 7
  lo8 = log --graph --pretty=compact --abbrev-commit -n 8
  lo9 = log --graph --pretty=compact --abbrev-commit -n 9
  lo0 = log --graph --pretty=compact --abbrev-commit -n 10

  # merge
  me  = merge
  mea = merge --abort
  mec = merge --continue

  # pull
  pl  = pull
  plr = pull --rebase

  # push
  ps  = push
  psf = push --force-with-lease

  # rebase
  rb  = rebase
  rbi = rebase --interactive
  rb1 = rebase --interactive HEAD~1
  rb2 = rebase --interactive HEAD~2
  rb3 = rebase --interactive HEAD~3
  rb4 = rebase --interactive HEAD~4
  rb5 = rebase --interactive HEAD~5
  rb6 = rebase --interactive HEAD~6
  rb7 = rebase --interactive HEAD~7
  rb8 = rebase --interactive HEAD~8
  rb9 = rebase --interactive HEAD~9
  rb0 = rebase --interactive HEAD~10
  rba = rebase --abort
  rbc = rebase --continue

  # reset
  rs  = reset
  rsc = reset --mixed HEAD^

  # status
  st  = status --short --branch

  # submodule
  smi = submodule update --init --recursive
  smu = submodule update --init --recursive --remote

  # switch
  sw  = switch

  # worktree
  wta = worktree add
  wtl = worktree list
  wtr = worktree remove


  # List aliases
  alias         = !git config --get-regexp '^alias[.]' | sed -e 's/^alias[.]//' -e 's/ /=/' | sort

  # List contributors
  contributors  = "!f() { if [ \"$#\" -eq 0 ]; then set -- HEAD; fi; git shortlog --summary --numbered \"$@\"; }; f"

  # Delete merged branches via the shared cleanup helper
  delete-merged = "!sh \"$HOME/.config/git/templates/hooks.local/clean-merged-branches\" --merged HEAD"

  # Who am I?
  whoami        = !git config user.email && git config user.name
