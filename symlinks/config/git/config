[user]
  name = sneivandt
  email = sneivandt@users.noreply.github.com
[github]
  user = sneivandt
[url "git@github.com:"]
  pushInsteadOf = https://github.com/
[core]
  autocrlf = input
  excludesfile = ~/.config/git/ignore
  attributesfile = ~/.config/git/attributes

[color]
  ui = true
[column]
  ui = auto
[branch]
  sort = -committerdate
[fetch]
  prune = true
  pruneTags = true
  writeCommitGraph = true
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
  templatedir = ~/.config/git/templates/
[merge]
  conflictstyle = zdiff3
[pull]
  rebase = true
[push]
  default = current
  followTags = true
  autoSetupRemote = true
[rebase]
  autoStash = true
[rerere]
  enabled = true
[status]
  showStash = false
  submoduleSummary = true
[tag]
  sort = version:refname

[diff]
  tool = vimdiff
  algorithm = histogram
  colorMoved = zebra
  submodule = log
[difftool]
  prompt = false

# manyFiles implies index.version=4 and core.untrackedCache=true.
[feature]
  manyFiles = true

[include]
  path = ~/.config/git/aliases
  path = ~/.config/git/delta
  path = ~/.config/git/windows

[includeIf "hasconfig:remote.*.url:https://*@dev.azure.com/**"]
  path = ~/.config/git/private/config
[includeIf "hasconfig:remote.*.url:https://*.visualstudio.com/**"]
  path = ~/.config/git/private/config
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:*/**"]
  path = ~/.config/git/private/config
