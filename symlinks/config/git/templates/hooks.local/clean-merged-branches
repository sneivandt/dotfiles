#!/bin/sh
set -eu

strict=0
default_branch=""
if [ "${1:-}" = "--merged" ]; then
  [ "$#" -eq 2 ] || {
    printf 'Usage: clean-merged-branches [--merged <ref>]\n' >&2
    exit 2
  }
  merged_ref=$2
  strict=1
elif [ "$#" -eq 0 ]; then
  if ! merged_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD); then
    # A repository need not have an origin or its default-branch symref.
    exit 0
  fi
  case "$merged_ref" in
    refs/remotes/origin/*) default_branch=${merged_ref#refs/remotes/origin/} ;;
    *) exit 0 ;;
  esac
else
  printf 'Usage: clean-merged-branches [--merged <ref>]\n' >&2
  exit 2
fi

current_branch=$(git branch --show-current 2>/dev/null || true)
worktrees=$(git worktree list --porcelain)

is_worktree_branch() {
  case "
$worktrees
" in
    *"
branch refs/heads/$1
"*)
      return 0
      ;;
  esac

  return 1
}

# Full refs keep branch names stable when tags have the same names.
# Finish both reads successfully before deleting anything. A pipe into the
# loop would act on partial output and hide a failed Git process.
refs=$(git for-each-ref --format='%(refname)' --merged="$merged_ref" refs/heads/)
status=0
while IFS= read -r ref; do
  case "$ref" in
    refs/heads/*) branch=${ref#refs/heads/} ;;
    *) continue ;;
  esac
  case "$branch" in
    ""|"$current_branch"|"$default_branch"|main|master|dev|develop)
      continue
      ;;
  esac

  if is_worktree_branch "$branch"; then
    continue
  fi

  if ! git branch -d -- "$branch"; then
    if [ "$strict" -eq 1 ]; then
      status=1
    fi
  fi
done <<EOF
$refs
EOF

exit "$status"
