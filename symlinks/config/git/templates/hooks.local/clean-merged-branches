#!/bin/sh
set -eu

if ! default_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD); then
  # A repository need not have an origin or its default-branch symref.
  exit 0
fi
case "$default_ref" in
  refs/remotes/origin/*) default_branch=${default_ref#refs/remotes/origin/} ;;
  *) exit 0 ;;
esac
current_branch=$(git branch --show-current 2>/dev/null)
worktrees=$(git worktree list --porcelain)

is_worktree_branch() {
  case "
$worktrees
" in
    *"
branch refs/heads/$1
"*)
      return 0
      ;;
  esac

  return 1
}

# Full refs keep branch names stable when tags have the same names.
# Finish both reads successfully before deleting anything. A pipe into the
# loop would act on partial output and hide a failed Git process.
refs=$(git for-each-ref --format='%(refname)' --merged="$default_ref" refs/heads/)
while IFS= read -r ref; do
  case "$ref" in
    refs/heads/*) branch=${ref#refs/heads/} ;;
    *) continue ;;
  esac
  case "$branch" in
    ""|"$current_branch"|"$default_branch"|main|master|dev|develop)
      continue
      ;;
  esac

  if is_worktree_branch "$branch"; then
    continue
  fi

  git branch -d -- "$branch" || continue
done <<EOF
$refs
EOF
