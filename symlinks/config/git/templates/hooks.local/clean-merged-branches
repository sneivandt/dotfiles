#!/bin/sh
set -eu

default_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
case "$default_ref" in
  refs/remotes/origin/*) default_branch=${default_ref#refs/remotes/origin/} ;;
  *) exit 0 ;;
esac
current_branch=$(git branch --show-current 2>/dev/null)
worktree_branches=$(
  git worktree list --porcelain 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      "branch refs/heads/"*)
        printf '%s\n' "${line#branch refs/heads/}"
        ;;
    esac
  done
)

is_worktree_branch() {
  case "
$worktree_branches
" in
    *"
$1
"*)
      return 0
      ;;
  esac

  return 1
}

# Full refs keep branch names stable when tags have the same names.
git for-each-ref --format='%(refname)' --merged="$default_ref" refs/heads/ | while IFS= read -r ref; do
  branch=${ref#refs/heads/}
  case "$branch" in
    ""|"$current_branch"|"$default_branch"|main|master|dev|develop)
      continue
      ;;
  esac

  if is_worktree_branch "$branch"; then
    continue
  fi

  git branch -d -- "$branch" || continue
done
