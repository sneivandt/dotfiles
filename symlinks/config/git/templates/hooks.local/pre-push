#!/bin/sh
set -eu

github_user=$(git config github.user 2>/dev/null || git config github.username 2>/dev/null || true)
remote=${2:-}
remote_owner=

# Skip for GitHub repos you own.
case $remote in
  git@github.com:*)
    remote_owner=${remote#git@github.com:}
    remote_owner=${remote_owner%%/*}
    ;;
  https://github.com/*)
    remote_owner=${remote#https://github.com/}
    remote_owner=${remote_owner%%/*}
    ;;
  ssh://git@github.com/*)
    remote_owner=${remote#ssh://git@github.com/}
    remote_owner=${remote_owner%%/*}
    ;;
esac

if [ -n "$github_user" ] && [ "$remote_owner" = "$github_user" ]
then
  exit 0
fi

# Prefer the destination remote's cached default; never substitute origin.
remote_name=${1:-}
default_ref=$(git symbolic-ref --quiet "refs/remotes/$remote_name/HEAD" 2>/dev/null || true)
default_branch=${default_ref#"refs/remotes/$remote_name/"}
if [ -z "$default_ref" ]; then
  # Newly added remotes may not have a cached HEAD. Do not consume push input
  # or open a second interactive credential prompt during discovery.
  default_branch=$(GIT_TERMINAL_PROMPT=0 git ls-remote --symref -- "$remote" HEAD </dev/null 2>/dev/null |
    sed -n 's/^ref: refs\/heads\/\(.*\)[[:space:]]HEAD$/\1/p')
fi
protected_branches=$(git config --get-all dotfiles.protectedBranch 2>/dev/null || true)

is_protected() {
  case "$1" in
    master|main|develop) return 0 ;;
  esac
  [ -n "$default_branch" ] && [ "$1" = "$default_branch" ] && return 0
  # One exact branch name per config value; no glob interpretation.
  printf '%s\n' "$protected_branches" | grep -Fxq -- "$1"
}

# Block updates to protected branches on repositories you do not own.
while read -r _local_ref _local_sha remote_ref _remote_sha
do
  case "$remote_ref" in
    refs/heads/*)
      branch=${remote_ref#refs/heads/}
      if is_protected "$branch"; then
        echo "You are pushing to protected branch $branch." >&2
        echo "Push with --no-verify to bypass this pre-push hook." >&2
        exit 1
      fi
      ;;
  esac
done
