[Unit]
Description=Hide Waybar on fullscreen Hyprland workspaces

PartOf=graphical-session.target waybar.service
Wants=graphical-session.target waybar.service
After=graphical-session.target waybar.service

ConditionFileIsExecutable=%h/.config/hypr/scripts/fullscreen-waybar.py

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/fullscreen-waybar.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
