[Unit]
Description=Apply managed GTK appearance and file chooser settings
PartOf=graphical-session.target
After=dbus.socket
Before=graphical-session.target
ConditionFileIsExecutable=/usr/bin/gsettings

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface color-scheme prefer-dark
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface icon-theme Tokyo-Night
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface font-name "Noto Sans 11"
ExecStart=/usr/bin/gsettings set org.gtk.Settings.FileChooser sort-directories-first true

[Install]
WantedBy=graphical-session.target
