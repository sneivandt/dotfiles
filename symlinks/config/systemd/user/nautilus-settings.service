[Unit]
Description=Apply managed Files appearance and view settings
PartOf=graphical-session.target
ConditionFileIsExecutable=/usr/bin/nautilus
ConditionFileIsExecutable=/usr/bin/gsettings

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface color-scheme prefer-dark
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface icon-theme Tokyo-Night
ExecStart=/usr/bin/gsettings set org.gnome.desktop.interface font-name "Noto Sans 11"
ExecStart=/usr/bin/gsettings set org.gnome.nautilus.preferences default-folder-viewer icon-view
ExecStart=/usr/bin/gsettings set org.gnome.nautilus.preferences always-use-location-entry false
ExecStart=/usr/bin/gsettings set org.gnome.nautilus.icon-view default-zoom-level medium
ExecStart=/usr/bin/gsettings set org.gtk.gtk4.Settings.FileChooser sort-directories-first true

[Install]
WantedBy=graphical-session.target
