[Unit]
Description=Apply managed Thunar view settings
PartOf=graphical-session.target
ConditionFileIsExecutable=/usr/bin/xfconf-query

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-view -n -t string -s ThunarDetailsView
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-show-hidden -n -t bool -s false
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-menubar-visible -n -t bool -s false
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-statusbar-visible -n -t bool -s false
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-location-bar -n -t string -s ThunarLocationButtons
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-toolbar-items -n -t string -s back:1,forward:1,location-bar:1,search:1,menu:1
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-side-pane -n -t string -s THUNAR_SIDEPANE_TYPE_SHORTCUTS
ExecStart=/usr/bin/xfconf-query -c thunar -p /shortcuts-icon-size -n -t string -s THUNAR_ICON_SIZE_16
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-window-maximized -n -t bool -s false
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-icon-view-zoom-level -n -t string -s THUNAR_ZOOM_LEVEL_100_PERCENT
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-details-view-zoom-level -n -t string -s THUNAR_ZOOM_LEVEL_50_PERCENT
ExecStart=/usr/bin/xfconf-query -c thunar -p /last-details-view-visible-columns -n -t string -s THUNAR_COLUMN_NAME,THUNAR_COLUMN_SIZE,THUNAR_COLUMN_DATE_MODIFIED

[Install]
WantedBy=graphical-session.target
