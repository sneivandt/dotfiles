[Unit]
Description=Apply managed Thunar view settings
PartOf=graphical-session.target
After=dbus.socket
Before=graphical-session.target
ConditionFileIsExecutable=/usr/bin/xfconf-query

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh "%h/.config/Thunar/managed-view-settings.sh" apply

[Install]
WantedBy=graphical-session.target
