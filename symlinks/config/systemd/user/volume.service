[Unit]
Description=Mute microphone capture at session startup

# Bound to the graphical session like the other desktop units: default.target
# would also fire for SSH and other non-graphical logins.
After=graphical-session.target
ConditionFileIsExecutable=%h/.config/volume/init-volume.sh

[Service]
Type=oneshot
ExecStart=%h/.config/volume/init-volume.sh

[Install]
WantedBy=graphical-session.target
