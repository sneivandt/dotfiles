{
    "layer": "top",
    "position": "top",
    "height": 26,
    "modules-left": ["group/workspaces", "custom/window"],
    "modules-center": [],
    "modules-right": ["custom/playing", "custom/stocks", "pulseaudio", "clock"],

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
            "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9"
        ]
    },

    "custom/ws1": {
        "exec": "~/.config/hypr/scripts/workspaces.py 1",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
        "tooltip": false
    },

    "custom/ws2": {
        "exec": "~/.config/hypr/scripts/workspaces.py 2",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
        "tooltip": false
    },

    "custom/ws3": {
        "exec": "~/.config/hypr/scripts/workspaces.py 3",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
        "tooltip": false
    },

    "custom/ws4": {
        "exec": "~/.config/hypr/scripts/workspaces.py 4",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
        "tooltip": false
    },

    "custom/ws5": {
        "exec": "~/.config/hypr/scripts/workspaces.py 5",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
        "tooltip": false
    },

    "custom/ws6": {
        "exec": "~/.config/hypr/scripts/workspaces.py 6",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
        "tooltip": false
    },

    "custom/ws7": {
        "exec": "~/.config/hypr/scripts/workspaces.py 7",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'",
        "tooltip": false
    },

    "custom/ws8": {
        "exec": "~/.config/hypr/scripts/workspaces.py 8",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'",
        "tooltip": false
    },

    "custom/ws9": {
        "exec": "~/.config/hypr/scripts/workspaces.py 9",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'",
        "tooltip": false
    },

    "custom/window": {
        "exec": "~/.config/hypr/scripts/window-title.py",
        "exec-if": "command -v hyprctl >/dev/null 2>&1 && test -x ~/.config/hypr/scripts/window-title.py",
        "return-type": "json",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "\uf028 {volume:3}%",
        "format-muted": "\uf028   0%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },

    "clock": {
        "format": "\uf073 {:%d %b %H:%M}",
        "tooltip": false
    },

    "custom/playing": {
        "exec": "~/.config/hypr/scripts/playing.sh",
        "exec-if": "command -v playerctl >/dev/null 2>&1 && test -x ~/.config/hypr/scripts/playing.sh",
        "interval": 5,
        "format": "\uf001 {}"
    },

    "custom/stocks": {
        "exec": "~/.config/hypr/scripts/stocks.sh",
        "exec-if": "command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && test -x ~/.config/hypr/scripts/stocks.sh",
        "interval": 300,
        "return-type": "json",
        "tooltip": false
    }
}
