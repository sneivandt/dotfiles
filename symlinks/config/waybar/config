{
    "layer": "bottom",
    "exclusive": true,
    "position": "top",
    "height": 30,
    "modules-left": ["group/workspaces", "custom/window"],
    "modules-center": [],
    "modules-right": ["custom/playing", "custom/stocks", "tray", "pulseaudio", "battery", "clock"],

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
            "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9"
        ]
    },

    "custom/ws1": {
        "exec": "~/.config/hypr/scripts/workspaces.py 1",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
        "tooltip": false
    },

    "custom/ws2": {
        "exec": "~/.config/hypr/scripts/workspaces.py 2",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
        "tooltip": false
    },

    "custom/ws3": {
        "exec": "~/.config/hypr/scripts/workspaces.py 3",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
        "tooltip": false
    },

    "custom/ws4": {
        "exec": "~/.config/hypr/scripts/workspaces.py 4",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
        "tooltip": false
    },

    "custom/ws5": {
        "exec": "~/.config/hypr/scripts/workspaces.py 5",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
        "tooltip": false
    },

    "custom/ws6": {
        "exec": "~/.config/hypr/scripts/workspaces.py 6",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
        "tooltip": false
    },

    "custom/ws7": {
        "exec": "~/.config/hypr/scripts/workspaces.py 7",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'",
        "tooltip": false
    },

    "custom/ws8": {
        "exec": "~/.config/hypr/scripts/workspaces.py 8",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'",
        "tooltip": false
    },

    "custom/ws9": {
        "exec": "~/.config/hypr/scripts/workspaces.py 9",
        "return-type": "json",
        "signal": 1,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'",
        "tooltip": false
    },

    "custom/window": {
        "exec": "~/.config/hypr/scripts/window-title.py",
        "exec-if": "command -v hyprctl >/dev/null 2>&1 && test -x ~/.config/hypr/scripts/window-title.py",
        "return-type": "json",
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "pulseaudio": {
        "format": "\uf028 {volume}%",
        "format-muted": "\uf028 0%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{time}"
    },

    "clock": {
        "format": "\uf073 {:%d %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<b>{}</b>",
                "days": "{}",
                "weeks": "<span color='#565f89'>W{}</span>",
                "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
                "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/playing": {
        "exec": "~/.config/hypr/scripts/playing.sh",
        "exec-if": "command -v playerctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && test -x ~/.config/hypr/scripts/playing.sh",
        "interval": 5,
        "format": "{}",
        "return-type": "json",
        "on-click": "playerctl --player=spotify play-pause",
        "on-click-middle": "playerctl --player=spotify previous",
        "on-click-right": "playerctl --player=spotify next"
    },

    "custom/stocks": {
        "exec": "~/.config/hypr/scripts/stocks.sh",
        "exec-if": "command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && test -x ~/.config/hypr/scripts/stocks.sh",
        "interval": 300,
        "signal": 2,
        "return-type": "json",
        "on-click": "~/.config/hypr/scripts/stocks.sh --toggle"
    }
}
