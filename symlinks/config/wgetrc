# Use --adjust-extension explicitly when mirroring web pages.
# Keeping URL filenames lets timestamping recognize existing downloads.

# Use the server-provided last modification date, if available
timestamping = on

# Retry limit
tries = 3

# Network timeout in seconds
timeout = 60

# Use --trust-server-names or --content-disposition explicitly when wanted.

# Use --continue explicitly only when resuming an unchanged remote file.

# Keep the default ~/.wget-hsts database to persist HTTPS-only policies.
