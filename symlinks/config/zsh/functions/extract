#!/usr/bin/env zsh

# Extract archives

local remove_archive=false
case "${1:-}" in
  --remove) remove_archive=true; shift ;;
esac
[[ "${1:-}" != -- ]] || shift
if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "Usage: extract [--remove] [--] <file>"
  return 1
fi

if [ ! -f "$1" ]; then
  echo "'$1' is not a valid file" 1>&2
  return 1
fi

# A relative filename can start with '-' even when quoted. Prefix it so every
# extractor treats it as a path without relying on tool-specific '--' support.
local archive="$1"
[[ "$archive" == /* ]] || archive="./$archive"

local -a extractor
case "$archive" in
  *.tar.bz2|*.tbz2|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.Z|*.tar|*.tar.zst|*.tzst) extractor=(tar xf) ;;
  *.bz2)            extractor=(bunzip2 -k) ;;
  *.gz)             extractor=(gunzip -k) ;;
  *.rar)            extractor=(unrar x) ;;
  *.zip)            extractor=(unzip) ;;
  *.7z)             extractor=(7z x) ;;
  *.Z)              extractor=(gunzip -k) ;;
  *.xz)             extractor=(unxz -k) ;;
  *.zst)            extractor=(unzstd -k) ;;
  *.deb)            extractor=(ar x) ;;
  *.rpm)            extractor=(bsdtar -xf) ;;
  *)                echo "'$1' cannot be extracted via extract()" 1>&2; return 1 ;;
esac

if ! command -v "${extractor[1]}" >/dev/null 2>&1; then
  printf 'extract: %s is required to extract %s\n' "${extractor[1]}" "$1" >&2
  return 127
fi

"${extractor[@]}" "$archive" || return $?
if "$remove_archive"; then
  rm -- "$archive"
fi
