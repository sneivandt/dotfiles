#!/usr/bin/env zsh

# Extract archives

if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "Usage: extract <file>"
  return 1
fi

if [ ! -f "$1" ]; then
  echo "'$1' is not a valid file" 1>&2
  return 1
fi

# A relative filename can start with '-' even when quoted. Prefix it so every
# extractor treats it as a path without relying on tool-specific '--' support.
local archive="$1"
[[ "$archive" == /* ]] || archive="./$archive"

case "$archive" in
  *.tar.bz2|*.tbz2|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.Z|*.tar|*.tar.zst|*.tzst) tar xf "$archive" ;;
  *.bz2)            bunzip2 "$archive" ;;
  *.gz)             gunzip  "$archive" ;;
  *.rar)            unrar x "$archive" ;;
  *.zip)            unzip   "$archive" ;;
  *.7z)             7z x    "$archive" ;;
  *.Z)              uncompress "$archive" ;;
  *.xz)             unxz    "$archive" ;;
  *.zst)            unzstd --rm "$archive" ;;
  *.deb)            ar x    "$archive" ;;
  *.rpm)            bsdtar -xf "$archive" ;;
  *)                echo "'$1' cannot be extracted via extract()" 1>&2; return 1 ;;
esac
