#!/usr/bin/env zsh
# shellcheck shell=bash  # Closest to zsh for shellcheck purposes

# Find file

# Keep failure handling local to this autoloaded function.
setopt localoptions pipefail

command -v fzf >/dev/null 2>&1 || { echo "ERROR: fzf not installed" 1>&2 && return 1; }

if ! command -v locate >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
  echo "ERROR: neither locate nor fd installed" 1>&2
  return 1
fi

local opts edit query file raw statuses search_status fzf_status
opts=$(getopt -o e -n ff -- "$@") || return 1
eval set -- "$opts"

while [ $# -gt 0 ]
do
  case "$1" in
    -e)
      edit=true
      ;;
    --)
      shift
      break
      ;;
  esac
  shift
done

if [ $# -ne 1 ] || [ -z "$1" ]
then
  echo "Usage: ff <file> [<options>]"
  echo
  echo "Options:"
  echo
  echo " -e :  Edit the file"
  return 1
fi
query="$1"

if command -v fd >/dev/null 2>&1; then
  raw="$(fd -0 --type f -- "$query" | fzf --read0 --print0 --no-multi -0 -1; printf '\0%s %s' "${pipestatus[1]}" "${pipestatus[2]}")"
else
  raw="$(locate -0 -- "$query" | fzf --read0 --print0 --no-multi -0 -1; printf '\0%s %s' "${pipestatus[1]}" "${pipestatus[2]}")"
fi
statuses=${raw##*$'\0'}
file=${raw%$'\0'*}
# Zsh preserves the NUL terminator in command substitution. Remove only that
# terminator so filenames ending in newlines retain their exact spelling.
file=${file%$'\0'}
search_status=${statuses%% *}
fzf_status=${statuses#* }

if (( fzf_status != 0 )); then
  # Cancelling fzf closes its stdin pipe while fd may still be writing (EPIPE
  # exits 1 in fd); preserve the cancellation status.
  if (( fzf_status == 130 )); then
    return 130
  fi
  if (( search_status != 0 && search_status != 141 )); then
    return "$search_status"
  fi
  return "$fzf_status"
fi
if [ -z "$file" ]; then
  if (( search_status != 0 )); then
    return "$search_status"
  fi
  return 1
fi
# Selecting a match early closes the pipe while fd/locate is still writing
# (EPIPE exits 1 in fd, SIGPIPE exits 141 in locate). Propagate other errors.
if (( search_status != 0 && search_status != 1 && search_status != 141 )); then
  return "$search_status"
fi

if [ -z "$edit" ]
then
  print -r -- "$file"
elif [ -f "$file" ]
then
  # Keep filenames from being interpreted as editor or sudo options.
  [[ "$file" == -* ]] && file="./$file"
  if [ -w "$file" ]
  then
    # Split command arguments and remove quoting without evaluating shell code.
    local -a editor_command
    editor_command=("${(@Q)${(z)${EDITOR:-vim}}}")
    command -v "$editor_command[1]" >/dev/null 2>&1 || { echo "ERROR: $editor_command[1] not installed" 1>&2 && return 1; }
    "${editor_command[@]}" "$file"
  elif command -v sudo >/dev/null 2>&1
  then
    sudo -e "$file"
  else
    echo "ERROR: $file is not writable and sudo is not installed" 1>&2
    return 1
  fi
else
  return 1
fi
