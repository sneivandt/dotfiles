#!/usr/bin/env zsh
# shellcheck shell=bash  # Closest to zsh for shellcheck purposes

# Find file

# Keep failure handling local to this autoloaded function.
setopt localoptions pipefail

command -v fzf >/dev/null 2>&1 || { echo "ERROR: fzf not installed" 1>&2 && return 1; }

if ! command -v locate >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
  echo "ERROR: neither locate nor fd installed" 1>&2
  return 1
fi

local opts edit query file
opts=$(getopt -o e -n ff -- "$@") || return 1
eval set -- "$opts"

while [ $# -gt 0 ]
do
  case "$1" in
    -e)
      edit=true
      ;;
    --)
      shift
      break
      ;;
  esac
  shift
done

if [ $# -ne 1 ] || [ -z "$1" ]
then
  echo "Usage: ff <file> [<options>]"
  echo
  echo "Options:"
  echo
  echo " -e :  Edit the file"
  return 1
fi
query="$1"

if command -v fd >/dev/null 2>&1; then
  file="$(fd -0 --type f -- "$query" | fzf --read0 --print0 --no-multi -0 -1)" || return $?
else
  file="$(locate -0 -- "$query" | fzf --read0 --print0 --no-multi -0 -1)" || return $?
fi
# Zsh preserves the NUL terminator in command substitution. Remove only that
# terminator so filenames ending in newlines retain their exact spelling.
file=${file%$'\0'}

if [ -z "$file" ]; then
  return 1
fi

if [ -z "$edit" ]
then
  print -r -- "$file"
elif [ -f "$file" ]
then
  if [ -w "$file" ]
  then
    command -v "${EDITOR:-vim}" >/dev/null 2>&1 || { echo "ERROR: ${EDITOR:-vim} not installed" 1>&2 && return 1; }
    ${EDITOR:-vim} "$file"
  elif command -v sudo >/dev/null 2>&1
  then
    sudo -e "$file"
  else
    echo "ERROR: $file is not writable and sudo is not installed" 1>&2
    return 1
  fi
else
  return 1
fi
