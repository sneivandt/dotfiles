#!/usr/bin/env zsh

# Generate ssh key for GitHub

command -v git        >/dev/null 2>&1 || { echo "ERROR: git not installed"        1>&2 && return 1; }
command -v ssh-keygen >/dev/null 2>&1 || { echo "ERROR: ssh-keygen not installed" 1>&2 && return 1; }

local key="$HOME/.ssh/github/id_ed25519"
local email

if [[ -e $key || -L $key || -e $key.pub || -L $key.pub ]]; then
  echo "Key already exists: $key or $key.pub" >&2
  return 1
fi

if ! email=$(git config --global user.email) || [[ -z ${email//[[:space:]]/} ]]; then
  echo "ERROR: set a global Git user.email before generating a GitHub key" >&2
  return 1
fi

# Do not change permissions on directories reached through user-owned links.
if [[ -L "$HOME/.ssh" || -L "$HOME/.ssh/github" ]]; then
  echo "ERROR: refusing to change permissions through an SSH directory symlink" >&2
  return 1
fi
mkdir -p -m 700 -- "$HOME/.ssh" "$HOME/.ssh/github" || return $?
chmod 700 -- "$HOME/.ssh" "$HOME/.ssh/github" || return $?

ssh-keygen -t ed25519 -C "$email" -f "$key"
