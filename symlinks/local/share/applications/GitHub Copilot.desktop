[Desktop Entry]
Categories=
Comment=Tauri Copilot Application
Exec=sh -c "exec \\"\\$HOME/.config/hypr/scripts/launch-github.sh\\" \\"\\$@\\"" sh %u
Icon=github
MimeType=x-scheme-handler/github-app;x-scheme-handler/ghapp;x-scheme-handler/gh
Name=GitHub Copilot
StartupWMClass=github
Terminal=false
Type=Application
