# ssh applies the first value it finds for each keyword, so specific hosts must
# come before the "Host *" defaults at the bottom of this file.

Host github.com
  User git
  HostName github.com
  LogLevel ERROR
  IdentityFile ~/.ssh/github/id_ed25519
  IdentitiesOnly yes
  PreferredAuthentications publickey

Host github-internal
  User git
  HostName github.com
  LogLevel ERROR
  IdentityFile ~/.ssh/github_internal/id_ed25519
  IdentitiesOnly yes
  PreferredAuthentications publickey

Host *.visualstudio.com *.dev.azure.com
  LogLevel ERROR
  IdentityFile ~/.ssh/ado/id_ed25519
  IdentitiesOnly yes
  PreferredAuthentications publickey

Host *
  TCPKeepAlive yes
  ServerAliveInterval 60
  ServerAliveCountMax 2
  AddKeysToAgent yes
  Compression yes
