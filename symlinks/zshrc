#!/usr/bin/env zsh

# Only run for interactive shells
[[ -o interactive ]] || return

# Guard against multiple sourcing
[ -n "${ZSHRC_LOADED:-}" ] && return
ZSHRC_LOADED=1

# Use the new pane's controlling terminal only when it is also stdin.
if [[ -t 0 && ${TTY:-} -ef /dev/fd/0 ]]; then
  export GPG_TTY="$TTY"
elif tty -s; then
  GPG_TTY="$(tty)"
  export GPG_TTY
fi

# Quiet
setopt no_beep
setopt NO_LIST_BEEP

# Word Style
autoload -Uz select-word-style
select-word-style bash

# Shared interactive helpers
[ -r ~/.config/shell/interactive.sh ] && . ~/.config/shell/interactive.sh

# History
setopt extended_history
setopt hist_ignore_space
setopt histignorealldups
setopt hist_expire_dups_first
setopt hist_find_no_dups
setopt hist_reduce_blanks
setopt hist_verify
setopt sharehistory
setopt extendedglob
if command -v _dotfiles_init_history >/dev/null 2>&1; then
  _dotfiles_init_history zsh Zsh
else
  HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
fi
# Keep a duplicate-entry cushion above the saved history limit.
HISTSIZE=120000
SAVEHIST=100000

# Various options
setopt autocd
setopt autopushd
setopt pushdminus
setopt pushdsilent
setopt pushdtohome

# Path
[ -r ~/.config/shell/path.sh ] && . ~/.config/shell/path.sh

# virtualenvwrapper
if command -v _dotfiles_init_virtualenvwrapper >/dev/null 2>&1; then
  _dotfiles_init_virtualenvwrapper
fi

# Aliases
[ -r ~/.config/shell/aliases.sh ] && . ~/.config/shell/aliases.sh

# GUI Aliases (optional)
[ -r ~/.config/shell/aliases-desktop.sh ] && . ~/.config/shell/aliases-desktop.sh

# Prompt
[ -r ~/.config/zsh/prompt.zsh ] && . ~/.config/zsh/prompt.zsh

# Completion
[ -r ~/.config/zsh/completion.zsh ] && . ~/.config/zsh/completion.zsh

# Key bindings
[ -r ~/.config/zsh/key-bindings.zsh ] && . ~/.config/zsh/key-bindings.zsh

# Plugins
for plugin in ~/.config/zsh/plugins/*.zsh(N)
do
  . "$plugin"
done

for plugin in \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
do
  if [[ -r $plugin ]]; then
    . "$plugin"
    break
  fi
done
unset plugin

# zoxide
if command -v zoxide >/dev/null 2>&1
then
  eval "$(zoxide init zsh)"
fi

# FZF (optional)
if command -v _dotfiles_init_fzf >/dev/null 2>&1; then
  _dotfiles_init_fzf zsh
fi

unset -f _dotfiles_init_history _dotfiles_init_virtualenvwrapper _dotfiles_init_fzf 2>/dev/null || true

# Functions
fpath=(~/.config/zsh/functions $fpath)
for func in ~/.config/zsh/functions/*(N)
do
  autoload -Uz "${func:t}"
done
unset func

for plugin in \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do
  if [[ -r $plugin ]]; then
    . "$plugin"
    break
  fi
done
unset plugin
