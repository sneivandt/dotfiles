#!/usr/bin/env zsh

# Only run for interactive shells
[[ -o interactive ]] || return

# Guard against multiple sourcing
[ -n "$ZSHRC_LOADED" ] && return
ZSHRC_LOADED=1

# Quiet
setopt no_beep
setopt NO_LIST_BEEP

# Word Style
autoload -Uz select-word-style
select-word-style bash

# History
setopt extended_history
setopt hist_ignore_space
setopt histignorealldups
setopt hist_expire_dups_first
setopt hist_find_no_dups
setopt hist_reduce_blanks
setopt hist_verify
setopt sharehistory
setopt extendedglob
[ -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" ] || mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
HISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/history"
HISTSIZE=100000
SAVEHIST=100000

# Various options
setopt autocd
setopt autopushd
setopt pushdminus
setopt pushdsilent
setopt pushdtohome

# Path
[ -r ~/.config/shell/path.sh ] && . ~/.config/shell/path.sh

# Aliases
[ -r ~/.config/shell/aliases.sh ] && . ~/.config/shell/aliases.sh

# GUI Aliases (optional)
[ -r ~/.config/shell/aliases-desktop.sh ] && . ~/.config/shell/aliases-desktop.sh

# Prompt
[ -r ~/.config/zsh/prompt.zsh ] && . ~/.config/zsh/prompt.zsh

# Completion
[ -r ~/.config/zsh/completion.zsh ] && . ~/.config/zsh/completion.zsh

# Key bindings
[ -r ~/.config/zsh/key-bindings.zsh ] && . ~/.config/zsh/key-bindings.zsh

# Plugins
for plugin in ~/.config/zsh/plugins/*.zsh(N)
do
  . "$plugin"
done

for plugin in \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
do
  [[ -r $plugin ]] && . "$plugin"
done
unset plugin

# zoxide
if command -v zoxide >/dev/null 2>&1
then
  eval "$(zoxide init zsh)"
fi

# FZF (optional)
# Distro packages ship the shell integration under /usr/share/fzf; elsewhere
# (Codespaces, Debian/Ubuntu, a manual install) fzf generates it itself. Keep
# this aligned with the equivalent block in bashrc, and note it must run before
# the fzf-history-widget check below, which depends on the keybindings.
if [ -f /usr/share/fzf/key-bindings.zsh ]; then
  . /usr/share/fzf/key-bindings.zsh
fi
if [ -f /usr/share/fzf/completion.zsh ]; then
  . /usr/share/fzf/completion.zsh
fi
if [ ! -f /usr/share/fzf/key-bindings.zsh ] && [ ! -f /usr/share/fzf/completion.zsh ] && command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

# Functions
fpath=(~/.config/zsh/functions $fpath)
for func in ~/.config/zsh/functions/*(N)
do
  autoload -Uz "${func:t}"
done
unset func

# Custom FZF Ctrl+R behavior: Execute immediately
if zle -l fzf-history-widget
then
  fzf-history-widget-accept() {
    fzf-history-widget
    if [[ $? -eq 0 ]]
    then
      zle accept-line
    fi
  }
  zle -N fzf-history-widget-accept
  bindkey '^R' fzf-history-widget-accept
fi

for plugin in \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do
  [[ -r $plugin ]] && . "$plugin"
done
unset plugin
